<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Online Shop</title>

    <link rel="stylesheet" href="css/style.css">
</head>

<body>

    <!-- HEADER -->
    <header class="header">
        <div class="container header-content">

            <a href="#" class="logo">
                ONLINE SHOP
            </a>

            <div class="search">
                <input
                    type="text"
                    id="searchInput"
                    placeholder="Pretraži proizvode..."
                >
            </div>

            <button class="cart-button" id="cartButton">
                🛒 Korpa
                <span id="cartCount">0</span>
            </button>

        </div>
    </header>


    <!-- HERO -->
    <section class="hero">
        <div class="container">
            <h1>Dobrodošli u našu prodavnicu</h1>

            <p>
                Pronađite proizvode koji vam trebaju brzo i jednostavno.
            </p>
        </div>
    </section>


    <!-- CATEGORIES -->
    <section class="categories-section">
        <div class="container">

            <h2>Kategorije</h2>

            <div
                class="categories"
                id="categories"
            >
            </div>

        </div>
    </section>


    <!-- PRODUCTS -->
    <main class="container products-section">

        <div class="section-header">

            <h2>Proizvodi</h2>

            <span id="productCount"></span>

        </div>

        <div
            class="products"
            id="products"
        >
        </div>

    </main>


    <!-- CART -->
    <div
        class="cart-overlay"
        id="cartOverlay"
    ></div>


    <aside
        class="cart"
        id="cart"
    >

        <div class="cart-header">

            <h2>Vaša korpa</h2>

            <button id="closeCart">
                ✕
            </button>

        </div>


        <div
            class="cart-items"
            id="cartItems"
        >
        </div>


        <div class="cart-footer">

            <div class="cart-total">

                <span>Ukupno:</span>

                <strong id="cartTotal">
                    0 RSD
                </strong>

            </div>

            <button
                class="checkout-button"
                id="checkoutButton"
            >
                Nastavi na poručivanje
            </button>

        </div>

    </aside>


    <!-- JAVASCRIPT -->
    <script src="js/app.js"></script>

</body>
</html>
